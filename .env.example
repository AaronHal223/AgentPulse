# ── Required ────────────────────────────────────────────────────────────────
# Claude API key (chat, web search, listing reading, scoring): https://console.anthropic.com
ANTHROPIC_API_KEY=
# Long random string used to sign login sessions. Generate: openssl rand -base64 32
AUTH_SECRET=

# Postgres connection string. Leave empty for local dev (an embedded database in ./.data is used).
# Required in production — a free Neon database works: https://neon.tech
DATABASE_URL=

# ── Drive times ─────────────────────────────────────────────────────────────
# Free OpenRouteService key for geocoding + drive minutes: https://openrouteservice.org/dev/#/signup
# Without it, you get no drive times (only straight-line miles when coordinates are known).
ORS_API_KEY=

# ── Daily brief email ───────────────────────────────────────────────────────
# Resend API key: https://resend.com (free tier). Verify your domain to send from it.
RESEND_API_KEY=
EMAIL_FROM="AgentPulse <brief@yourdomain.com>"
# Secret the scheduler sends to /api/cron/* . Generate: openssl rand -hex 24
CRON_SECRET=
# Public URL of the app (used for links in emails)
APP_URL=http://localhost:3000

# ── Optional ────────────────────────────────────────────────────────────────
# ANTHROPIC_MODEL=claude-sonnet-5-5
# APP_TIMEZONE=America/New_York
# CRON_BUDGET_SECONDS=200
